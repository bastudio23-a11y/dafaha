rules_version = '2';

// Dafaha's new multiplayer sessions are handled by the authenticated
// Render room API, not by client-side Firestore writes. This disables
// insecure legacy room mutations after the rules are explicitly deployed.
//
// IMPORTANT: Deploy only after confirming this Firebase database is
// dedicated to Dafaha and the current Render version is active.
// Updating this repository file does NOT deploy Firestore rules.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
